# FitMind AI Backend - Environment Variables Example
# Copy this file to .env and fill in the values

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitmind_db

# Security & Authentication
JWT_SECRET=change_this_to_a_secure_random_32_byte_string_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI Provider (Google Gemini Developer API Free Tier - Backend-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


