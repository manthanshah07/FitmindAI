# FitMind AI — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─────────────────────────────────────────────
# FRONTEND VARIABLES (Vite — must be prefixed VITE_)
# ─────────────────────────────────────────────

# URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─────────────────────────────────────────────
# BACKEND VARIABLES (FastAPI — set in backend/.env)
# These are listed here for reference only.
# ─────────────────────────────────────────────

# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/fitmind

# JWT configuration
# JWT_SECRET=generate-a-secure-random-string-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# Google Gemini (Developer API Free Tier — Backend-only — NEVER expose API key to browser)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=30

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# Environment
# ENVIRONMENT=development
