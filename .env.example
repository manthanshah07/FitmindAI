# FitMind AI — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─────────────────────────────────────────────
# FRONTEND VARIABLES (Vite — must be prefixed VITE_)
# ─────────────────────────────────────────────

# URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase public URL (for file storage)
VITE_SUPABASE_URL=

# Supabase anonymous key (safe to expose on client)
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# BACKEND VARIABLES (FastAPI — separate .env in backend repo)
# These are listed here for reference only.
# ─────────────────────────────────────────────

# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/fitmind

# JWT configuration
# JWT_SECRET=generate-a-secure-random-string-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Supabase (server-side service key — NEVER expose to browser)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# Environment
# ENVIRONMENT=development
